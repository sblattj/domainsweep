# TLD priority. Bracketed or bare comma list both work; spaces ok; leading dots ok.
DOMAIN_SORT_KEY=[com,ai,io,co,app,dev,live,me,net,org,so,sh,xyz,gg,to,us]

# Variant strategies to try after the exact name, in tier order.
# Any of: spelling,leet,affix,vowel
DOMAIN_VARIANTS=spelling,leet,affix,vowel

# Cap on generated variants (the exact name is always checked).
DOMAIN_MAX_VARIANTS=25

# Cap on total domains checked per run.
DOMAIN_LIMIT=80

# Parallel lookups. WHOIS registries rate-limit hard; 6 is safe.
DOMAIN_CONCURRENCY=6

# Per-lookup timeout in milliseconds.
DOMAIN_TIMEOUT_MS=8000
